# Xifona site config — single source of truth for every URL/detail that's
# currently a [BRACKET] placeholder in the HTML.
#
# 1. Fill in the values below.
# 2. Run: node scripts/generate-config.js
#    This regenerates js/config.js (used by every page at runtime) and
#    patches the production domain into robots.txt, sitemap.xml, and the
#    canonical/OG/Twitter meta tags in every HTML page.
# 3. Reload the site — links, emails, and text update automatically.
#
# Leave a value empty to keep showing its [BRACKET] placeholder on the site
# (or, for RATING/PRESS_LOGOS/TESTIMONIALS, to keep that section hidden).

# Production domain (no trailing slash). Used for canonical/OG tags, sitemap.xml, robots.txt.
SITE_URL=https://www.xifona.app

# App store links
APP_STORE_URL=
PLAY_STORE_URL=

# Support / legal contact
SUPPORT_EMAIL=hello@xifona.com
CONTACT_FORM_ENDPOINT=

# Social links (footer icons)
INSTAGRAM_URL=https://www.instagram.com/xifona.app/
FACEBOOK_URL=https://www.facebook.com/profile.php?id=61593253516547
X_URL=https://x.com/xifona_app

# Legal entity details (Privacy Policy / Terms)
COMPANY_LEGAL_NAME=Xifona
COMPANY_ADDRESS=Kolkota
JURISDICTION=
LAST_UPDATED_DATE=August 13, 2026

# Pricing (Pricing page plan card)
APP_PRICE_MONTHLY=$8.99
APP_TRIAL_TEXT=3-Day Free Trial

# Social proof (Home page) — leave empty to hide the section entirely
# rather than show a faked/placeholder number.
RATING=5
PRESS_LOGOS=
TESTIMONIALS=

# Optional analytics snippet (e.g. Plausible or GA4), inserted before </head>
# on every page. Leave empty to skip analytics entirely. Single line only.
ANALYTICS_SNIPPET=
